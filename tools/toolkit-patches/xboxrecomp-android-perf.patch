+/*
+ * recomp_cpu_tls.h - the guest's per-thread registers as one thread-local
+ * (Android), included by recomp_types.h and src/kernel/xbox_memory_layout.h
+ * right after they define RECOMP_TLS.
+ *
+ * On Android the game is a library the activity dlopens, so its TLS is the
+ * dynamic kind: every thread-local a function touches is a TLS descriptor
+ * call (tlsdesc_resolver_dynamic), one per variable. With each register its
+ * own thread-local that was 21 % of the guest thread's time on a Snapdragon
+ * 8 Elite. As fields of one thread-local, a function resolves the block once
+ * and reaches each register at an offset from it. (Local-dynamic TLS would
+ * do the same, but lld has no AArch64 TLSLD relocations.)
+ *
+ * RECOMP_CPU_STRUCT is defined where the block is used; the names stay the
+ * same (g_eax is g_recomp_cpu.r_eax; r_, as recomp_types.h defines eax
+ * and the rest as macros), so the generated code and the runtime
+ * read as before. With it, nothing may declare the registers one by one:
+ * those declarations are under #ifndef RECOMP_CPU_STRUCT.
+ */
+#ifndef RECOMP_CPU_TLS_H
+#define RECOMP_CPU_TLS_H
+
+#if defined(__ANDROID__)
+#define RECOMP_CPU_STRUCT 1
+#endif
+
+#ifdef RECOMP_CPU_STRUCT
+#include <stdint.h>
+
+/* The same two unions as recomp_types.h and xbox_memory_layout.h, under the
+ * same guards: whichever comes first defines them. */
+#ifndef RECOMP_MMX_DEFINED
+#define RECOMP_MMX_DEFINED
+typedef union RecompMmx {
+    int8_t   b[8];
+    uint8_t  ub[8];
+    int16_t  w[4];
+    uint16_t uw[4];
+    int32_t  d[2];
+    uint32_t ud[2];
+    uint64_t q;
+} RecompMmx;
+#endif
+
+#ifndef RECOMP_XMM_DEFINED
+#define RECOMP_XMM_DEFINED
+typedef union RecompXmm {
+    float    f[4];
+    double   d[2];
+    uint32_t u[4];
+    int32_t  i[4];
+    uint64_t q[2];
+} RecompXmm;
+#endif
+
+typedef struct RecompCpu {
+    /* the integer registers first: what nearly every function touches */
+    uint32_t r_eax, r_ecx, r_edx, r_esp, r_ebx, r_esi, r_edi, r_ebp;
+    uint32_t r_eflags;
+    int      r_df;
+    uint32_t r_fs_base, r_seh_ebp;
+    /* x87 */
+    double   r_fp_stack[8];
+    int      r_fp_top;
+    int      r_fp_cmp;
+    uint16_t r_fp_control_word, r_fp_cc;
+    RecompXmm r_xmm[8];
+    RecompMmx r_mm[8];
+} RecompCpu;
+
+extern RECOMP_TLS RecompCpu g_recomp_cpu;
+
+#define g_eax             (g_recomp_cpu.r_eax)
+#define g_ecx             (g_recomp_cpu.r_ecx)
+#define g_edx             (g_recomp_cpu.r_edx)
+#define g_esp             (g_recomp_cpu.r_esp)
+#define g_ebx             (g_recomp_cpu.r_ebx)
+#define g_esi             (g_recomp_cpu.r_esi)
+#define g_edi             (g_recomp_cpu.r_edi)
+#define g_ebp             (g_recomp_cpu.r_ebp)
+#define g_eflags          (g_recomp_cpu.r_eflags)
+#define g_df              (g_recomp_cpu.r_df)
+#define g_fs_base         (g_recomp_cpu.r_fs_base)
+#define g_seh_ebp         (g_recomp_cpu.r_seh_ebp)
+#define g_fp_stack        (g_recomp_cpu.r_fp_stack)
+#define g_fp_top          (g_recomp_cpu.r_fp_top)
+#define g_fp_cmp          (g_recomp_cpu.r_fp_cmp)
+#define g_fp_control_word (g_recomp_cpu.r_fp_control_word)
+#define g_fp_cc           (g_recomp_cpu.r_fp_cc)
+#define g_xmm0            (g_recomp_cpu.r_xmm[0])
+#define g_xmm1            (g_recomp_cpu.r_xmm[1])
+#define g_xmm2            (g_recomp_cpu.r_xmm[2])
+#define g_xmm3            (g_recomp_cpu.r_xmm[3])
+#define g_xmm4            (g_recomp_cpu.r_xmm[4])
+#define g_xmm5            (g_recomp_cpu.r_xmm[5])
+#define g_xmm6            (g_recomp_cpu.r_xmm[6])
+#define g_xmm7            (g_recomp_cpu.r_xmm[7])
+#define g_mm0             (g_recomp_cpu.r_mm[0])
+#define g_mm1             (g_recomp_cpu.r_mm[1])
+#define g_mm2             (g_recomp_cpu.r_mm[2])
+#define g_mm3             (g_recomp_cpu.r_mm[3])
+#define g_mm4             (g_recomp_cpu.r_mm[4])
+#define g_mm5             (g_recomp_cpu.r_mm[5])
+#define g_mm6             (g_recomp_cpu.r_mm[6])
+#define g_mm7             (g_recomp_cpu.r_mm[7])
+#endif /* RECOMP_CPU_STRUCT */
+
+#endif /* RECOMP_CPU_TLS_H */
