+static long cpu_max_freq(int cpu)
+{
+    char path[96];
+    long f = -1;
+    FILE *fp;
+
+    snprintf(path, sizeof path, "/sys/devices/system/cpu/cpu%d/cpufreq/cpuinfo_max_freq", cpu);
+    fp = fopen(path, "r");
+    if (!fp)
+        return -1;
+    if (fscanf(fp, "%ld", &f) != 1)
+        f = -1;
+    fclose(fp);
+    return f;
+}
+
+int recomp_android_guest_cpu(void)
+{
+    cpu_set_t set;
+    int i, fast = recomp_android_fast_cpu(), twin = -1;
+    long top;
+
+    if (fast < 0 || sched_getaffinity(0, sizeof set, &set) != 0)
+        return fast;
+    top = cpu_max_freq(fast);
+    for (i = 0; i < 64 && i < CPU_SETSIZE; i++)
+        if (i != fast && CPU_ISSET(i, &set) && top > 0 && cpu_max_freq(i) == top)
+            twin = i;
+    if (twin >= 0)
+        return twin;
+    i = recomp_android_cpu_rank(1);
+    return i >= 0 ? i : fast;
+}
+
