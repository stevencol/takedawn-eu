# pins.env: every outside thing a release build fetches or runs, by exact
# version and hash. Sourced by the build scripts; change a pin here and
# nowhere else. Downloads are checked against the sha256 before use.

# macOS: the SDL the Mac builds have always run on (Homebrew's "sdl2" is
# sdl2-compat over SDL3), built here from source so the app needs no Homebrew
# and runs on the deployment target below, not only on the build Mac's macOS.
SDL3_VERSION=3.4.18
SDL3_URL=https://github.com/libsdl-org/SDL/releases/download/release-3.4.18/SDL3-3.4.18.tar.gz
SDL3_SHA256=9c75cf16330322c217dedd2e0609f1124f1b54b8633e763467b4684d0f4334a3
SDL2COMPAT_VERSION=2.32.74
SDL2COMPAT_URL=https://github.com/libsdl-org/sdl2-compat/releases/download/release-2.32.74/sdl2-compat-2.32.74.tar.gz
SDL2COMPAT_SHA256=ec68abde77e2e459c8abc4f9587b8976b5d2a657b2bfda2fb3a079b0f8924588
MACOS_DEPLOYMENT_TARGET=13.0
MACOS_BUNDLE_ID=com.stevencol.takedawn

# The setup window's Qt: a qt.io kit fetched with aqtinstall into the cache
# (Homebrew's Qt drags ICU in and triples the size). Only qtbase is needed.
QT_VERSION=6.10.3
AQT_VERSION=3.3.0
# Linux: the qt.io binaries of this version need glibc 2.34, so qtbase is
# built from its source archive inside the sniper container
# (tools/release/linux/build-qt.sh). This archive is also Qt's corresponding
# source for the Linux package.
QTBASE_SRC_URL=https://download.qt.io/official_releases/qt/6.10/6.10.3/submodules/qtbase-everywhere-src-6.10.3.tar.xz
QTBASE_SRC_SHA256=383dc907816338f0cba72088a524c07458dfc69ce684ca9132fcc4fe91c24b0b

# Windows: llvm-mingw, SDL2, the Vulkan headers and glslang are pinned in
# tools/win/fetch-deps.sh (and tools/install/pins.json); the setup compiler:
INNOSETUP_VERSION=6.7.3

# Linux: the Steam Runtime 3 "sniper" SDK image, by digest, and the tool that
# packs the AppDir.
SNIPER_SDK_IMAGE=registry.gitlab.steamos.cloud/steamrt/sniper/sdk@sha256:1c33c507bc75d012e77df5727f93b0d5b8c3f7c8d4142ba5f7a16882cc92e014
APPIMAGE_RUNTIME_URL=https://github.com/AppImage/type2-runtime/releases/download/20251108/runtime-x86_64
APPIMAGE_RUNTIME_SHA256=2fca8b443c92510f1483a883f60061ad09b46b978b2631c807cd873a47ec260d
